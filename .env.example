# Reference names for configuring GitHub Actions.
#
# Do not put real credentials in this file or commit a populated .env file.
# Add FTP_SERVER, FTP_USERNAME, FTP_PASSWORD, and FTP_SERVER_DIR under:
# GitHub repository -> Settings -> Secrets and variables -> Actions -> Secrets
#
# Add FTP_PROTOCOL and FTP_PORT under the Variables tab. They are optional;
# the workflow defaults to explicit FTPS on port 21.

FTP_SERVER=ftp.example.com
FTP_USERNAME=your-ftp-username
FTP_PASSWORD=your-ftp-password
FTP_SERVER_DIR=/webroot/wordpress/
FTP_PROTOCOL=ftps
FTP_PORT=21

